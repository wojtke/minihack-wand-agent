{
  "env": "CartPole-v1",
  "num_envs": 4,
  "seed": 1,
  "steps": 500000,
  "num_steps": 128,
  "learning_rate": 0.00025,
  "anneal_lr": true,
  "gamma": 0.99,
  "gae_lambda": 0.95,
  "num_minibatches": 4,
  "update_epochs": 4,
  "norm_adv": true,
  "clip_coef": 0.2,
  "clip_vloss": true,
  "ent_coef": 0.01,
  "vf_coef": 0.5,
  "max_grad_norm": 0.5,
  "target_kl": null,
  "hidden": [64, 64],
  "activation": "tanh",
  "shared": false,
  "lstm": 0,
  "save_every": 100000,
  "log_every": 50
}
