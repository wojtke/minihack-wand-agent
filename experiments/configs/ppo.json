{
  "env": "wod",
  "levels": ["Easy", "Medium", "Hard", "Pro"],
  "envs_per_level": 2,
  "visit_bonus": 0.0,
  "bonus_cap": 2.0,
  "seed": 1,
  "steps": 10000000,
  "num_steps": 128,
  "learning_rate": 0.00025,
  "anneal_lr": true,
  "gamma": 0.99,
  "gae_lambda": 0.95,
  "num_minibatches": 4,
  "update_epochs": 4,
  "norm_adv": true,
  "clip_coef": 0.2,
  "clip_vloss": true,
  "ent_coef": 0.01,
  "vf_coef": 0.5,
  "max_grad_norm": 0.5,
  "target_kl": null,
  "hidden": [128, 128],
  "activation": "relu",
  "shared": false,
  "lstm": 0,
  "save_every": 500000,
  "log_every": 20
}
